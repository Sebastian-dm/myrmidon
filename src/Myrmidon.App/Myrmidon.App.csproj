<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\Default.json" />
    <None Remove="Images\Default.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\Default.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\Default.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bramble.Core\Bramble.Core.csproj" />
    <ProjectReference Include="..\Myrmidon.Core\Myrmidon.Core.csproj" />
    <ProjectReference Include="..\Myrmidon.Terminal\Myrmidon.Terminal.csproj" />
  </ItemGroup>

</Project>